# ---------- VK ----------
VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_ADMIN_USER_ID=
VK_API_VERSION=5.199
# Беседа, куда бот пишет по умолчанию (2000000000 + chat_id). Пусто = взять из БД (/connect).
VK_CHAT_PEER_ID=
VK_GROUP_SCREEN_NAME=

# ---------- Telegram (probe now, full channel later) ----------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CHAT_ID=
# http:// или socks5://; для probe пока только http://, пусто = напрямую
TELEGRAM_PROXY=
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT=25
# Только для проверки связи до разработки: запускает HTTP-probe вместо бота
# PROBE_MODE=telegram

# ---------- Работа ----------
# В Docker/Amvera: /data/bot.db. Локально можно оставить пустым.
DATABASE_PATH=
SCAN_INTERVAL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=25
HTTP_USER_AGENT=FreelanceMonitor/2.0 (personal research; contact: you@example.com)
LOG_LEVEL=INFO
HEALTH_PORT=8080
TZ=Europe/Moscow
# Публичный HTTPS-адрес для кнопки «Откликнуться» (redirect /go/<order_id>).
# Пусто = кнопка ведёт напрямую на страницу заказа (Kwork VK блокирует).
PUBLIC_BASE_URL=
# 1 = не отправлять в VK, печатать карточки в лог
DRY_RUN=0

# ---------- Источники ----------
FL_RU_ENABLED=true
FL_RU_RSS_URL=https://www.fl.ru/rss/all.xml
FL_RU_MAX_DETAIL_FETCH=8

FREELANCE_RU_ENABLED=true
FREELANCE_RU_URL=https://freelance.ru/projects/
FREELANCE_RU_PAGES=2

KWORK_ENABLED=true
KWORK_URL=https://kwork.ru/projects
KWORK_PAGES=2

# ---------- Отбор ----------
KEYWORDS_JSON=["telegram бот","тг бот","телеграм бот","вк бот","vk бот","бот","парсер","парсинг","скрипт","автоматизация","python","интеграция api","api интеграция","google таблицы","google sheets","сбор данных","webhook","n8n","ai агент","ии агент","gpt","openai","llm","selenium","playwright","rest api","fastapi","excel","csv"]
STOPWORDS_JSON=["1с","1c","bitrix","битрикс","wordpress","вордпресс","php","laravel","opencart","modx","drupal","joomla","dle","seo","продвижение","дизайн","верстка","фронтенд","frontend","крипта","смарт-контракт","solidity","3d","монтаж","озвучка","перевод","копирайт","статьи","смм","таргет","бухгалтер","юридическ","курьер","инфографика","логотип","нейминг","презентац","тестирование","тестировщик","qa","аудит","вакансия","оклад","полная занятость","отзывы","холодн","менеджер по продажам","скрипт продаж","оператор колл","пришлите резюме","требуется резюме"]
MIN_SCORE=40
MAX_ORDERS_PER_CYCLE=10
BUDGET_MIN_RUB=15000

# ---------- ИИ (OpenAI-совместимый API) ----------
OPENAI_BASE_URL=https://api.aitunnel.ru/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4.1-flash-1017
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=900
LLM_ENABLED=true
LLM_DAILY_TOKEN_LIMIT=300000

# ---------- Векторная память / эмбеддинги ----------
# По умолчанию используется тот же провайдер, что и OPENAI_*.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DAILY_TOKEN_LIMIT=3000000
EMBEDDING_TIMEOUT_SECONDS=60

# ---------- GitHub-база проектов ----------
GITHUB_ENABLED=true
GITHUB_OWNER=markmus11012020-max
# Fine-grained token, read-only. Без него GitHub даёт 60 запросов/час.
GITHUB_TOKEN=
# Пусто = все публичные репозитории. Иначе: owner/repo,owner/repo2
GITHUB_REPOS=
GITHUB_INCLUDE_PRIVATE=false
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_ARCHIVED=false
GITHUB_SYNC_INTERVAL_SECONDS=3600
# Жёсткий клиентский лимит, чтобы не выходить за бесплатные 60/час.
GITHUB_MAX_REQUESTS_PER_HOUR=55
GITHUB_MAX_REPO_MB=25
GITHUB_MAX_FILES_PER_REPO=80
GITHUB_MAX_CHUNKS_PER_REPO=120
GITHUB_MAX_FILE_KB=200
GITHUB_MAX_TOTAL_KB_PER_REPO=2048
GITHUB_SUMMARY_ENABLED=true
GITHUB_SUMMARY_MAX_TOKENS=900

# ---------- Поиск и память ----------
RAG_TOP_K=8
RAG_FINAL_PROJECTS=2
RAG_MIN_SCORE=0.25
SHORT_MEMORY_TTL_DAYS=7
SHORT_MEMORY_MAX_MESSAGES=20
USER_MEMORY_MAX_FACTS=50
